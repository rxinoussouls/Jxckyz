local placeId = game.PlaceId

local games = {
    [124216119978534]      = { name = "Ride A Pet",     url = "https://api.jnkie.com/api/v1/luascripts/public/f24bce221ee7e8ac777b6182b3da3fa404a51a1d269a9b6145b7034b6089b1bc/download"  },
}

local MAX_RETRIES = 3
local RETRY_DELAY = 1.5

local function log(msg) print("[VYNX] " .. msg) end
local function warnLog(msg) warn("[VYNX] " .. msg) end

local function fetchScript(url)
    for attempt = 1, MAX_RETRIES do
        local ok, result = pcall(function() return game:HttpGet(url) end)
        if ok and result and #result > 0 then
            return result
        end
        warnLog(("Fetch attempt %d/%d failed%s"):format(attempt, MAX_RETRIES, ok and "" or (": " .. tostring(result))))
        if attempt < MAX_RETRIES then task.wait(RETRY_DELAY) end
    end
    return nil
end

local entry = games[placeId]

if not entry then
    warnLog(("Place ID %d is not supported."):format(placeId))
    return
end

log(("Detected game: %s (Place %d)"):format(entry.name, placeId))
log("Fetching script...")

local source = fetchScript(entry.url)
if not source then
    warnLog(("Failed to fetch script for %s after %d attempts."):format(entry.name, MAX_RETRIES))
    return
end

local compiled, compileErr = loadstring(source)
if not compiled then
    warnLog("Failed to compile script: " .. tostring(compileErr))
    return
end

local ok, runErr = pcall(compiled)
if ok then
    log(("%s loaded successfully."):format(entry.name))
else
    warnLog(("%s failed during execution: %s"):format(entry.name, tostring(runErr)))
end
