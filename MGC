local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local player = game:GetService("Players").LocalPlayer
local Window = Rayfield:CreateWindow({Name = "Auto Spin Pro", LoadingTitle = "Monitoring Plot...", LoadingSubtitle = "Auto-Stop Enabled"})
local MainTab = Window:CreateTab("Dashboard", nil)

local AutoFarmEnabled = false
local SelectedRarities = {}
local InfoLabels = {}

for i = 1, 9 do InfoLabels[i] = MainTab:CreateLabel("Pad " .. i .. ": Waiting...") end

local Toggle = MainTab:CreateToggle({
    Name = "Enable Auto Farm",
    CurrentValue = false,
    Callback = function(Value) AutoFarmEnabled = Value end
})

MainTab:CreateDropdown({
    Name = "Select Target Rarity (Auto-Stop)",
    Options = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"},
    CurrentOption = {"Legendary", "Mythic"},
    MultipleOptions = true,
    Callback = function(Options) SelectedRarities = Options end
})

task.spawn(function()
    while true do
        if AutoFarmEnabled then
            local myPlot = nil
            local plots = workspace:FindFirstChild("Main") and workspace.Main:FindFirstChild("Plots")
            
            -- หา Plot
            if plots then
                for i = 1, 8 do
                    local p = plots:FindFirstChild("Plot" .. i)
                    if p and p.MiddlePart:FindFirstChild("PlotUI") and string.find(p.MiddlePart.PlotUI.NameText.Text, player.Name) then
                        myPlot = p
                        break
                    end
                end
            end

            if myPlot then
                local spinPads = myPlot:FindFirstChild("SpinPads")
                for j = 1, 9 do
                    local pad = spinPads and spinPads:FindFirstChild("Pad" .. j)
                    local infoFrame = pad and pad.OutPart:FindFirstChild("InfoUI") and pad.OutPart.InfoUI:FindFirstChild("InfoFrame")
                    
                    if infoFrame then
                        local rarity = infoFrame.RarityText.Text
                        InfoLabels[j]:Set("Pad " .. j .. ": " .. infoFrame.NameText.Text .. " [" .. rarity .. "]")
                        
                        -- เช็ค Rarity
                        for _, allowed in pairs(SelectedRarities) do
                            if string.find(rarity, allowed) then
                                -- เจอของที่ต้องการ!
                                fireproximityprompt(pad.OutPart.TakePrompt)
                                
                                -- หยุดทุกอย่าง
                                AutoFarmEnabled = false
                                Toggle:Set(false) -- อัปเดต UI ให้ปิดเอง
                                Rayfield:Notify({Title = "Success!", Content = "Found " .. rarity .. "! Stopping farm.", Duration = 5})
                                break
                            end
                        end
                    end
                end
                
                -- ถ้า AutoFarm ยังเปิดอยู่ ให้ Spin/Reveal ต่อ
                if AutoFarmEnabled then
                    local SpinService = game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("_Index"):WaitForChild("sleitnick_knit@1.7.0"):WaitForChild("knit"):WaitForChild("Services"):WaitForChild("SpinService"):WaitForChild("RF")
                    pcall(function()
                        SpinService.Spin:InvokeServer()
                        SpinService.Reveal:InvokeServer()
                    end)
                end
            end
        end
        task.wait(0.3)
    end
end)
